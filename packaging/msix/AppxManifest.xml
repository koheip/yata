<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store に出す MSIX の設定。
  Identity の Name と Publisher、PublisherDisplayName は Partner Center の
  「製品 ID」ページに出る値に書きかえること（docs/distribution.md を参照）。
  Version は release.yml がタグから書きかえる。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="REPLACE.WITH.PACKAGE.NAME"
    Publisher="CN=REPLACE-WITH-PUBLISHER-ID"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>ヤタ</DisplayName>
    <PublisherDisplayName>REPLACE WITH PUBLISHER NAME</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>調べる、読む、ブラウザを動かす個人用AIアシスタント</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-jp" />
  </Resources>

  <Applications>
    <Application Id="Yata" Executable="Yata\Yata.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ヤタ"
        Description="個人用AIアシスタント"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
