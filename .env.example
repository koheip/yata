# どれか1つ設定すれば起動できます。未設定のプロバイダは UI で「キー未設定」になります。
# デモモデル（demo）はキーなしでツールの流れだけ確認できます。

# Google AI Studio の API キー
GEMINI_API_KEY=

# OpenAI の API キー
OPENAI_API_KEY=

# Anthropic Console の API キー
ANTHROPIC_API_KEY=

# OpenAI 互換のローカルサーバー（Ollama）。キーは不要です。
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 既定のモデル id: gemini | openai | anthropic | ollama | demo
YATA_MODEL=gemini

# 上流のモデル名。使いたいモデルに合わせて変えてください。
YATA_GEMINI_MODEL=gemini-2.5-flash
YATA_OPENAI_MODEL=gpt-4o-mini
YATA_ANTHROPIC_MODEL=claude-sonnet-4-5
YATA_OLLAMA_MODEL=gemma3:4b

YATA_HOST=127.0.0.1
YATA_PORT=8741
# 起動したら画面を開く（開かない場合は false、または uv run yata --no-browser）
YATA_OPEN_BROWSER=true
# Edge / Chrome の専用ウィンドウで開く（false ならいつものブラウザのタブ。uv run yata --browser-tab でも同じ）
YATA_APP_WINDOW=true
YATA_DB=data/yata.db

# 1ターンでモデルがツールを呼べる回数の上限
YATA_MAX_STEPS=8

# 個人利用では true（localhost の文書も読める）。
# 公開サービスにするときは false にして、プライベートアドレスを拒否してください。
# クラウドのメタデータアドレス (169.254.169.254) はどちらの設定でも拒否します。
YATA_ALLOW_PRIVATE_URLS=true

# ルーティン。ブラウザを閉じても、このプロセスが動いていれば実行します。
YATA_SCHEDULER_ENABLED=true
YATA_SCHEDULER_INTERVAL_SECONDS=30
YATA_TIMEZONE=Asia/Tokyo

# Google 連携（Gmail / カレンダー）。どちらも未設定なら、起動はするが連携は「未設定」のままで、
# Gmail とカレンダーのツールはモデルに提示されません。設定方法は README.md を参照してください。
# ダウンロードした client_secret*.json のパスを指定する場合（推奨）
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
# JSON ファイルを使わず、クライアントIDとシークレットを直接書く場合
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Chatwork 連携。API トークンを設定すると「接続済み」になり、Chatwork のツールが使えます。
# トークンは Chatwork の「サービス連携」>「API トークン」で発行できます。
CHATWORK_API_TOKEN=

# 楽天市場連携。https://webservice.rakuten.co.jp/ でアプリ ID とアクセスキー（pk_…）を取得。
# バックエンドサービスを選び、この PC のグローバル IP を許可 IP に登録してください。
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# 任意。アフィリエイト ID は https://affiliate.rakuten.co.jp/ で確認できます。
RAKUTEN_AFFILIATE_ID=
# Webアプリケーションの場合のみ、登録サイトと完全一致する Origin を設定。
RAKUTEN_ORIGIN=

# freee 会計: https://app.secure.freee.co.jp/developers でアプリを登録
# コールバック URL: http://127.0.0.1:{YATA_PORT}/api/connectors/freee/oauth/callback
# 既定ポートの場合: http://127.0.0.1:8741/api/connectors/freee/oauth/callback
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=

# LINE 連携
# 送信はアクセストークンだけで動く。LINE からの受信（Webhook）にはシークレットも必要
# チャネル基本設定
LINE_CHANNEL_SECRET=
# Messaging API設定 → チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=
# 自分の userId。チャネル基本設定の「あなたのユーザーID」、カンマ区切り
LINE_ALLOWED_USER_IDS=
# 127.0.0.1 のみで待ち受け。scripts/line-tunnel.ps1 で公開
LINE_WEBHOOK_PORT=8742

# Backlog 連携。スペースの URL（例: https://example.backlog.jp）と、個人設定 → API で発行した API キー。
BACKLOG_SPACE=
BACKLOG_API_KEY=

# kintone 連携。URL（例: https://example.cybozu.com）と、アプリの設定 → API トークン（複数はカンマ区切り）。
KINTONE_DOMAIN=
KINTONE_API_TOKENS=

# マネーフォワード クラウド請求書。https://app-portal.moneyforward.com/ でアプリを作る。
# リダイレクト URI: http://127.0.0.1:8741/api/connectors/moneyforward/oauth/callback
MONEYFORWARD_CLIENT_ID=
MONEYFORWARD_CLIENT_SECRET=

# ほかの AI（OpenAI 互換）。キーを入れるとモデル選択に出る。*_MODEL は空ならキー保存時に選ぶ。
XAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
PLAMO_API_KEY=

# PC の中で動く AI（動いているものだけがモデル選択に出る）。
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# JAN_BASE_URL=http://127.0.0.1:1337/v1
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# その他の OpenAI 互換サーバー
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

# kagi 経由（上級者向け）。ヤタに本物の API キーを置かず、kagi（https://github.com/koheip/kagi）が
# 通信のたびにキーを付けます。ヤタが持つのは証明書と、数分で切れるトークンだけです。
# 4つ（URL・CA・証明書・秘密鍵）がそろうと、モデル一覧に「kagi 経由」が出ます。詳しくは docs/kagi.md。
KAGI_URL=
KAGI_CA_FILE=
KAGI_CERT_FILE=
KAGI_KEY_FILE=
# kagi のポリシーにある上流の名前と、使うモデル
KAGI_UPSTREAM=openai
KAGI_MODEL=gpt-4o-mini
KAGI_TOKEN_TTL=10m

# 完全オフライン（PC の中の AI だけを使い、ネットに出る道具と連携を止める）
YATA_OFFLINE=false
