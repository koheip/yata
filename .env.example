# どれか1つ設定すれば起動できます。未設定のプロバイダは UI で「キー未設定」になります。
# デモモデル（demo）はキーなしでツールの流れだけ確認できます。

# Google AI Studio の API キー
GEMINI_API_KEY=

# OpenAI の API キー
OPENAI_API_KEY=

# Anthropic Console の API キー
ANTHROPIC_API_KEY=

# OpenAI 互換のローカルサーバー（Ollama）。キーは不要です。
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 既定のモデル id: gemini | openai | anthropic | ollama | demo
TOMOSHIBI_MODEL=gemini

# 上流のモデル名。使いたいモデルに合わせて変えてください。
TOMOSHIBI_GEMINI_MODEL=gemini-2.5-flash
TOMOSHIBI_OPENAI_MODEL=gpt-4o-mini
TOMOSHIBI_ANTHROPIC_MODEL=claude-sonnet-4-5
TOMOSHIBI_OLLAMA_MODEL=gemma3:4b

TOMOSHIBI_HOST=127.0.0.1
TOMOSHIBI_PORT=8741
TOMOSHIBI_DB=data/tomoshibi.db

# 1ターンでモデルがツールを呼べる回数の上限
TOMOSHIBI_MAX_STEPS=8

# 個人利用では true（localhost の文書も読める）。
# 公開サービスにするときは false にして、プライベートアドレスを拒否してください。
# クラウドのメタデータアドレス (169.254.169.254) はどちらの設定でも拒否します。
TOMOSHIBI_ALLOW_PRIVATE_URLS=true
